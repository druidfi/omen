{
    "name": "druidfi/omen",
    "type": "library",
    "description": "",
    "license": "MIT",
    "authors": [
        {
            "name": "Druid.fi",
            "homepage": "https://github.com/druidfi",
            "role": "Maintainer"
        },
        {
            "name": "Marko Korhonen",
            "homepage": "https://github.com/back-2-95"
        }
    ],
    "autoload": {
        "psr-4": {
            "Druidfi\\Omen\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Druidfi\\Omen\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.1",
        "drupal/core-recommended": "^10.0 || ^11.0 || ^12.0",
        "ext-json": "*"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^2.17 || ^3.15",
        "phpunit/phpunit": "^9.6 || ^12.0"
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "drupal/core-composer-scaffold": true,
            "symfony/runtime": false
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "test": [
            "@test-lagoon",
            "@test-ddev",
            "@test-lando",
            "@test-pantheon",
            "@test-tugboat",
            "@test-upsun",
            "@test-wodby",
            "@test-unknown"
        ],
        "test-lagoon": [
            "APP_ENV=dev phpunit --configuration tests/Lagoon.xml",
            "APP_ENV=test phpunit --configuration tests/Lagoon.xml",
            "APP_ENV=prod phpunit --configuration tests/Lagoon.xml"
        ],
        "test-ddev": [
            "APP_ENV=dev phpunit --configuration tests/Ddev.xml",
            "APP_ENV=test phpunit --configuration tests/Ddev.xml",
            "APP_ENV=prod phpunit --configuration tests/Ddev.xml"
        ],
        "test-lando": [
            "APP_ENV=dev phpunit --configuration tests/Lando.xml",
            "APP_ENV=test phpunit --configuration tests/Lando.xml",
            "APP_ENV=prod phpunit --configuration tests/Lando.xml"
        ],
        "test-pantheon": [
            "APP_ENV=dev phpunit --configuration tests/Pantheon.xml",
            "APP_ENV=test phpunit --configuration tests/Pantheon.xml",
            "APP_ENV=prod phpunit --configuration tests/Pantheon.xml"
        ],
        "test-tugboat": [
            "APP_ENV=dev phpunit --configuration tests/Tugboat.xml",
            "APP_ENV=test phpunit --configuration tests/Tugboat.xml",
            "APP_ENV=prod phpunit --configuration tests/Tugboat.xml"
        ],
        "test-upsun": [
            "APP_ENV=dev phpunit --configuration tests/Upsun.xml",
            "APP_ENV=test phpunit --configuration tests/Upsun.xml",
            "APP_ENV=prod phpunit --configuration tests/Upsun.xml"
        ],
        "test-wodby": [
            "APP_ENV=dev phpunit --configuration tests/Wodby.xml",
            "APP_ENV=test phpunit --configuration tests/Wodby.xml",
            "APP_ENV=prod phpunit --configuration tests/Wodby.xml"
        ],
        "test-unknown": [
            "APP_ENV=dev phpunit --configuration tests/Unknown.xml",
            "APP_ENV=test phpunit --configuration tests/Unknown.xml",
            "APP_ENV=prod phpunit --configuration tests/Unknown.xml"
        ]
    }
}
